{
  "name": "meta-AI",
  "tagline": "使用 Pi Coding Agent 直連 Meta Model API（Muse Spark）",
  "description": "以 Pi Coding Agent 作為小龍蝦執行引擎，模型直連 Meta Model API。安裝時設定 META_API_KEY，預設使用 Muse Spark 1.3，也可改選較便宜的 Contributor 版本。",
  "category": "ai",
  "tags": ["pi", "meta", "muse-spark", "byok"],
  "version": "1.1.0",
  "support_url": "https://github.com/duotify/GitHubClawToolkit/issues",
  "homepage": "https://learn.duotify.com/courses/githubclaw",
  "requireEnv": ["META_API_KEY"],
  "byokFlow": true,
  "byokConfig": {
    "path": ".pi/settings.json",
    "providerField": "defaultProvider",
    "modelField": "defaultModel",
    "merge": true
  },
  "providers": [
    {
      "id": "meta-ai",
      "label": "Meta Model API",
      "description": "透過 Meta Model API 使用 Muse Spark，安裝時設定 META_API_KEY。",
      "isDefault": true,
      "secretName": "META_API_KEY",
      "defaultModel": "muse-spark-1.3",
      "models": [
        { "value": "muse-spark-1.3", "label": "Muse Spark 1.3" },
        { "value": "muse-spark-1.3-contributor", "label": "Muse Spark 1.3 Contributor" }
      ]
    }
  ]
}
